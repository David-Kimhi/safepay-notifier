# Copy to deploy/ec2/.env on the instances that need it (postgres, gateway, worker).
# The file is git-ignored; never commit real values.
# Private IPs (KAFKA_HOST, REDIS_HOST, ...) are NOT set here: scripts/aws/deploy.sh
# looks them up from EC2 and injects them on every deploy.

POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=safepay

# monitor only
GRAFANA_ADMIN_PASSWORD=change-me
